# Frontend (Vite) environment variables
# LIFF ID from LINE Developers Console
VITE_LIFF_ID=your-liff-id-here
# Backend API base URL used by frontend requests
# 網域根路徑即可；程式會自行加上 /api/...（勿結尾加 /api，否則會變 /api/api/...）
VITE_API_BASE_URL=https://care.jamessu2016.com
# 本機預設略過 LINE 登入（避免 localhost redirect 400）。
# 若要本機真測登入：LINE Console Endpoint 改成 http://localhost:5173，再設 true
VITE_FORCE_LIFF_LOGIN=false
